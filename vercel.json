{
  "headers": [
    { "source": "/lib/(.*)\\.onnx", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }, { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/lib/lang/(.*)", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }, { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/lib/(.*)\\.(js|mjs|wasm)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
